---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Similoluwa Soremekun"
  description="The requested page could not be found."
>
  <div class="mx-auto max-w-4xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 text-center">
    <div class="inline-flex items-center justify-center rounded-xl border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-xs text-accent mb-6">
      Error 404
    </div>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-text-primary">
      Page Not Found
    </h1>
    <p class="mt-4 text-base text-text-secondary max-w-md mx-auto">
      The resource or documentation page you requested does not exist or may have been relocated.
    </p>

    <div class="mt-8 flex items-center justify-center gap-4">
      <a
        href="/"
        class="rounded-lg border border-accent bg-accent px-5 py-2.5 text-xs font-semibold text-white hover:bg-accent-hover transition-colors"
      >
        Return to Home
      </a>
      <a
        href="/projects"
        class="rounded-lg border border-dark-subtle bg-dark-card px-5 py-2.5 text-xs font-semibold text-text-secondary hover:text-text-primary hover:border-dark-border transition-colors"
      >
        View Projects
      </a>
    </div>
  </div>
</BaseLayout>
