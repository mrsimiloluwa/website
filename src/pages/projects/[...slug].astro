---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import TechBadge from '@components/TechBadge.astro';
import MetricCard from '@components/MetricCard.astro';
import ArchitectureDiagram from '@components/ArchitectureDiagram.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, shortDescription, category, tags, metrics, githubUrl, liveUrl, role, timeline, status, keyTakeaway } =
  project.data;
---

<BaseLayout title={title} description={shortDescription} article={true}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center space-x-2 text-xs font-mono text-text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/projects" class="hover:text-text-primary transition-colors">Projects</a>
      <span>/</span>
      <span class="text-text-secondary truncate">{title}</span>
    </nav>

    <!-- Header Block -->
    <header class="border-b border-dark-subtle pb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center text-xs font-mono font-medium text-accent uppercase tracking-wider">
          {category}
        </span>
        <span class="text-text-muted text-xs">•</span>
        <span class="text-xs font-mono text-text-secondary">{timeline}</span>
        <span class="text-text-muted text-xs">•</span>
        <span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          {status}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary sm:leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg leading-relaxed text-text-secondary">
        {shortDescription}
      </p>

      <!-- Project Metadata Grid -->
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 py-4 px-5 rounded-lg border border-dark-subtle bg-dark-surface/50 text-xs">
        <div>
          <div class="text-text-muted font-mono uppercase text-[10px]">Role</div>
          <div class="mt-1 font-medium text-text-primary">{role}</div>
        </div>
        <div>
          <div class="text-text-muted font-mono uppercase text-[10px]">Timeline</div>
          <div class="mt-1 font-medium text-text-primary">{timeline}</div>
        </div>
        <div>
          <div class="text-text-muted font-mono uppercase text-[10px]">Architecture</div>
          <div class="mt-1 font-medium text-text-primary">5-Tier Governed</div>
        </div>
        <div>
          <div class="text-text-muted font-mono uppercase text-[10px]">Primary Dialect</div>
          <div class="mt-1 font-medium text-text-primary">PostgreSQL / DuckDB</div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-accent bg-accent/15 px-4 py-2 text-xs font-semibold text-accent-light shadow-sm transition-all hover:bg-accent hover:text-white"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Launch Live Streamlit Application</span>
          </a>
        )}
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-dark-subtle bg-dark-card px-4 py-2 text-xs font-semibold text-text-primary transition-all hover:border-dark-border hover:bg-dark-hover"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>View Source Repository</span>
          </a>
        )}
      </div>

      <!-- Tech Stack Badges -->
      <div class="mt-6 flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-mono text-text-muted mr-1">Stack:</span>
        {tags.map((tag) => (
          <TechBadge name={tag} />
        ))}
      </div>
    </header>

    <!-- Key Metrics Grid -->
    {metrics && metrics.length > 0 && (
      <section class="my-8">
        <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-text-muted mb-4">
          Key Performance & Validation Metrics
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {metrics.map((m, idx) => (
            <MetricCard
              label={m.label}
              value={m.value}
              detail={m.detail}
              highlight={idx === 0}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Visual Architecture Diagram Callout -->
    {project.slug === 'financial-services-analytics-platform' && (
      <ArchitectureDiagram />
    )}

    <!-- Core Takeaway Banner -->
    {keyTakeaway && (
      <div class="my-8 rounded-lg border border-accent/30 bg-accent/5 p-4 sm:p-5">
        <div class="flex items-start space-x-3">
          <div class="mt-0.5 text-accent">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-accent font-mono">
              Core Engineering Principle
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-text-secondary">
              {keyTakeaway}
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- Main Markdown/MDX Content -->
    <article class="prose-dark mt-8 pt-4">
      <Content />
    </article>

    <!-- Post-Article Navigation -->
    <div class="mt-16 pt-8 border-t border-dark-subtle flex items-center justify-between">
      <a
        href="/projects"
        class="inline-flex items-center text-xs font-medium text-text-secondary hover:text-accent transition-colors"
      >
        <svg class="mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to All Projects</span>
      </a>

      <a
        href="#top"
        class="inline-flex items-center text-xs font-medium text-text-muted hover:text-text-primary transition-colors"
      >
        <span>Back to Top</span>
        <svg class="ml-1 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
