        <div>• dbt Manifest Extraction</div>
        <div>• Dependency DAG Lineage</div>
        <div>• Column Classifications</div>
        <div>• Strict Formula Catalog</div>
      </div>
    </div>

    <!-- Tier 5: Warehouse & Orchestration -->
    <div class="rounded-lg border border-dark-border bg-dark-card p-3.5 flex flex-col justify-between">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-semibold mb-1">Tier 5</div>
        <div class="font-semibold text-text-primary text-sm mb-1.5">Data Warehouse</div>
        <div class="text-text-muted text-[11px] leading-relaxed mb-3">
          Dual warehouse engines with automated DAG orchestration.
        </div>
      </div>
      <div class="space-y-1 font-mono text-[10px] text-text-secondary bg-dark-base/60 p-2 rounded border border-dark-subtle/60">
        <div>• PostgreSQL 16 Warehouse</div>
        <div>• DuckDB Embedded Engine</div>
        <div>• 9 Kimball Star Marts</div>
        <div>• Apache Airflow 2.10.3</div>
        <div>• 462 dbt Data Tests</div>
      </div>
    </div>
  </div>

  <!-- Reconciled Accounting Bridge Indicator -->
  <div class="mt-4 pt-3 border-t border-dark-subtle/60 flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono text-text-muted">
    <div class="flex items-center space-x-2">
      <span class="text-accent font-semibold">Accounting Bridge:</span>
      <span>Gross (€467.4k) − Waivers (€8.1k) − Arrears (€29.3k) − Pass-Through (€21.5k)</span>
    </div>
    <div class="text-text-primary font-semibold bg-dark-base px-2.5 py-1 rounded border border-dark-subtle">
      = Net Recognized Revenue: €408,602.64
    </div>
  </div>
</div>
