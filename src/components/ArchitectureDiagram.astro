<div class="my-8 overflow-hidden rounded-xl border border-dark-subtle bg-dark-surface/60 p-5 sm:p-6">
  <div class="flex items-center justify-between border-b border-dark-subtle/80 pb-3 mb-6">
    <div class="flex items-center space-x-2">
      <div class="h-2.5 w-2.5 rounded-full bg-accent"></div>
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-text-primary">
        5-Tier Architectural Topology & Security Boundary
      </span>
    </div>
    <span class="text-[11px] font-mono text-text-muted">PostgreSQL 16 • dbt Core • LangGraph • SQLGlot</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3.5 text-xs">
    <!-- Tier 1: Presentation -->
    <div class="rounded-lg border border-dark-border bg-dark-card p-3.5 flex flex-col justify-between">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-accent font-semibold mb-1">Tier 1</div>
        <div class="font-semibold text-text-primary text-sm mb-1.5">Presentation Tier</div>
        <div class="text-text-muted text-[11px] leading-relaxed mb-3">
          Executive Streamlit application with 5 interactive financial workspaces.
        </div>
      </div>
      <div class="space-y-1 font-mono text-[10px] text-text-secondary bg-dark-base/60 p-2 rounded border border-dark-subtle/60">
        <div>• Executive Overview</div>
        <div>• Customer Leaderboard</div>
        <div>• Billing Arrears Registry</div>
        <div>• AI Financial Copilot</div>
        <div>• Governed Metric Catalog</div>
      </div>
    </div>

    <!-- Tier 2: Application & API -->
    <div class="rounded-lg border border-dark-border bg-dark-card p-3.5 flex flex-col justify-between">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-accent font-semibold mb-1">Tier 2</div>
        <div class="font-semibold text-text-primary text-sm mb-1.5">Application & API</div>
        <div class="text-text-muted text-[11px] leading-relaxed mb-3">
          Asynchronous REST backend with typed contracts and telemetry.
        </div>
      </div>
      <div class="space-y-1 font-mono text-[10px] text-text-secondary bg-dark-base/60 p-2 rounded border border-dark-subtle/60">
        <div>• FastAPI + Pydantic v2</div>
        <div>• API Key Authentication</div>
        <div>• Sliding-Window Rate Limit</div>
        <div>• OpenAPI /docs Schema</div>
        <div>• Structured Telemetry</div>
      </div>
    </div>

    <!-- Tier 3: AI Security Boundary -->
    <div class="rounded-lg border border-accent/40 bg-dark-card p-3.5 flex flex-col justify-between relative">
      <div class="absolute -top-2.5 right-2 bg-accent/20 border border-accent/40 text-accent text-[9px] font-mono px-1.5 py-0.5 rounded">
        Security Boundary
      </div>
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-accent font-semibold mb-1">Tier 3</div>
        <div class="font-semibold text-text-primary text-sm mb-1.5">AI Orchestration</div>
        <div class="text-text-muted text-[11px] leading-relaxed mb-3">
          Directed state machine with compile-time AST verification.
        </div>
      </div>
      <div class="space-y-1 font-mono text-[10px] text-accent-light bg-accent/5 p-2 rounded border border-accent/20">
        <div>• LangGraph 8-Node Graph</div>
        <div>• SQLGlot AST Parser</div>
        <div>• Single SELECT Root Gate</div>
        <div>• Mart Schema Allowlist</div>
        <div>• Row Limit Clamping (1k)</div>
      </div>
    </div>

    <!-- Tier 4: Metadata & Governance -->
    <div class="rounded-lg border border-dark-border bg-dark-card p-3.5 flex flex-col justify-between">
      <div>
        <div class="text-[10px] font-mono uppercase tracking-wider text-amber-400 font-semibold mb-1">Tier 4</div>
        <div class="font-semibold text-text-primary text-sm mb-1.5">Governance & dbt</div>
        <div class="text-text-muted text-[11px] leading-relaxed mb-3">
          Compilation artifacts, column classification, and lineage tracking.
        </div>
      </div>
      <div class="space-y-1 font-mono text-[10px] text-text-secondary bg-dark-base/60 p-2 rounded border border-dark-subtle/60">
