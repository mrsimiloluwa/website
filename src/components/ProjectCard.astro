---
import TechBadge from './TechBadge.astro';

interface Props {
  title: string;
  slug: string;
  description: string;
  category: string;
  tags: string[];
  metrics?: Array<{ label: string; value: string }>;
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
}

const {
  title,
  slug,
  description,
  category,
  tags,
  metrics = [],
  githubUrl,
  liveUrl,
  featured = false,
} = Astro.props;
---

<article
  class={`group relative flex flex-col justify-between rounded-xl border p-6 transition-all duration-200 ${
    featured
      ? 'border-dark-border bg-dark-card/80 hover:border-accent/50 hover:bg-dark-hover/80'
      : 'border-dark-subtle bg-dark-card/50 hover:border-dark-border hover:bg-dark-card/90'
  }`}
>
  <div>
    <!-- Category & Status Badge -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center text-xs font-mono font-medium text-accent uppercase tracking-wider">
        {category}
      </span>
      {featured && (
        <span class="inline-flex items-center gap-1 rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-[10px] font-medium text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Featured Platform
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl font-semibold tracking-tight text-text-primary group-hover:text-accent-light transition-colors">
      <a href={`/projects/${slug}`} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true" />
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="mt-2.5 text-sm leading-relaxed text-text-secondary">
      {description}
    </p>

    <!-- Key Metrics Highlight (if any) -->
    {metrics.length > 0 && (
      <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-3 border-t border-dark-subtle/60">
        {metrics.map((m) => (
          <div class="rounded-md bg-dark-surface/80 p-2 border border-dark-subtle/60">
            <div class="text-[10px] font-mono uppercase text-text-muted">{m.label}</div>
            <div class="text-xs font-mono font-semibold text-text-primary">{m.value}</div>
          </div>
        ))}
      </div>
    )}

    <!-- Tech Tags -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <TechBadge name={tag} />
      ))}
    </div>
  </div>

  <!-- Footer Actions / Links -->
  <div class="relative z-10 mt-6 flex items-center justify-between pt-4 border-t border-dark-subtle/80 text-xs">
    <a
      href={`/projects/${slug}`}
      class="inline-flex items-center font-medium text-accent hover:text-accent-light transition-colors"
    >
      <span>Read Architecture Case Study</span>
      <svg class="ml-1.5 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    <div class="flex items-center space-x-3 text-text-muted">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-text-primary transition-colors p-1"
          title="Inspect GitHub Repository"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
      )}
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent transition-colors p-1"
          title="Open Live Application Demo"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
